{
  "name": "ZANGO — Your Business, Discovered",
  "short_name": "ZANGO",
  "description": "A WhatsApp-first marketplace for discovering northern Nigeria's entrepreneurs, sellers, and local products.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#C05A3F",
  "background_color": "#FCF9F5",
  "categories": ["shopping", "business", "lifestyle", "productivity"],
  "icons": [
    { "src": "/icons/icon-72x72.png", "sizes": "72x72", "type": "image/png" },
    { "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "/icons/icon-128x128.png", "sizes": "128x128", "type": "image/png" },
    { "src": "/icons/icon-144x144.png", "sizes": "144x144", "type": "image/png" },
    { "src": "/icons/icon-152x152.png", "sizes": "152x152", "type": "image/png" },
    { "src": "/icons/icon-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-384x384.png", "sizes": "384x384", "type": "image/png" },
    { "src": "/icons/icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-icon-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Search marketplace", "short_name": "Search", "description": "Find products and sellers", "url": "/search?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Explore sellers", "short_name": "Sellers", "description": "Browse verified sellers", "url": "/sellers?source=pwa-shortcut", "icons": [{ "src": "/icons/icon-96x96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
